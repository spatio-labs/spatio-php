{
    "version": "0.0.2",
    "description": "PHP SDK for the SpatioAPI. Generated from the official OpenAPI spec.",
    "keywords": [
        "openapitools",
        "openapi-generator",
        "openapi",
        "php",
        "sdk",
        "rest",
        "api"
    ],
    "homepage": "https://www.spatio.app/developers/docs/sdk",
    "license": "MIT",
    "authors": [
        {
            "name": "Spatio Labs",
            "email": "hello@spatio.app"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.3",
        "guzzlehttp/psr7": "^1.7 || ^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^8.0 || ^9.0",
        "friendsofphp/php-cs-fixer": "^3.5"
    },
    "autoload": {
        "psr-4": {
            "SpatioClient\\": "lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SpatioClient\\Test\\": "test/"
        }
    },
    "name": "spatio-labs/spatio-php",
    "support": {
        "issues": "https://github.com/spatio-labs/spatio-php/issues",
        "source": "https://github.com/spatio-labs/spatio-php"
    }
}